import time
from google import genai
from google.genai import types

# Initialize client using GEMINI_API_KEY from environment
client = genai.Client()

print("1. Uploading training dataset...")
training_file = client.files.upload(
    file="dataset.jsonl",
    config=types.UploadFileConfig(mime_type="application/json")
)

print("2. Starting Fine-Tuning job...")
tuning_job = client.tunings.tune(
    base_model="models/gemini-2.5-flash",  # Current standard base model
    training_dataset=types.TuningDataset(
        gcs_uri=None,
    ),
    config=types.CreateTuningJobConfig(
        tuned_model_display_name="nova-chatbot-v1",
        epoch_count=5,
        batch_size=4,
        learning_rate=0.001,
    )
)

print(f"Job created! Name: {tuning_job.name}")

# Poll status until complete
while tuning_job.state in ["JOB_STATE_PENDING", "JOB_STATE_RUNNING"]:
    print("⏳ Training in progress... checking again in 30 seconds.")
    time.sleep(30)
    tuning_job = client.tunings.get(name=tuning_job.name)

print(f" Training Finished! State: {tuning_job.state}")
print(f" Your Tuned Model Endpoint: {tuning_job.tuned_model.endpoint}")